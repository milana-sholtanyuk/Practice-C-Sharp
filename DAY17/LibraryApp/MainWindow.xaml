<Window x:Class="LibraryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LibraryApp"
        xmlns:vm="clr-namespace:LibraryApp.ViewModels"
        Title="📚 Электронная библиотека" Height="650" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Animations/BookAnimations.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:StatusToTextConverter x:Key="StatusToTextConverter"/>
            <local:StatusToColorConverter x:Key="StatusToColorConverter"/>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddBookCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditBookCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DeleteBookCommand}"/>
    </Window.InputBindings>

    <Window.DataContext>
        <vm:LibraryViewModel/>
    </Window.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Книги">
                <MenuItem Header="Добавить" Command="{Binding AddBookCommand}"/>
                <MenuItem Header="Редактировать" Command="{Binding EditBookCommand}"/>
                <MenuItem Header="Удалить" Command="{Binding DeleteBookCommand}"/>
            </MenuItem>
            <MenuItem Header="_Поиск"/>
            <MenuItem Header="_Настройки"/>
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <Button Content="➕ Добавить" Command="{Binding AddBookCommand}"/>
            <Button Content="✏ Редактировать" Command="{Binding EditBookCommand}"/>
            <Button Content="❌ Удалить" Command="{Binding DeleteBookCommand}"/>
        </ToolBar>

        <Border Padding="15" Background="#F5F5F5">
            <Grid x:Name="MainGrid" Loaded="MainGrid_Loaded">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📚 Электронная библиотека" FontSize="28" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#2C3E50"/>

                <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Height="35" Margin="0,0,0,10" VerticalContentAlignment="Center"
                         FontSize="14"/>

                <Grid Grid.Row="2" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding FilterAuthor, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,5,0" Height="30" VerticalContentAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding FilterGenre, UpdateSourceTrigger=PropertyChanged}" 
                             Height="30" VerticalContentAlignment="Center"/>
                </Grid>

                <Border Grid.Row="3" Background="#E8F4FD" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="⏳ Загрузка..." HorizontalAlignment="Center" FontWeight="Bold"/>
                </Border>

                <DataGrid x:Name="BooksGrid" Grid.Row="4" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          RowHeight="50" Margin="0,0,0,10" Background="White" 
                          BorderBrush="#DDD" BorderThickness="1">

                    <DataGrid.Resources>
                        
                        <Style TargetType="DataGridRow">
                            <EventSetter Event="MouseLeftButtonDown" Handler="Row_MouseLeftButtonDown"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <EventSetter Event="MouseLeftButtonDown" Handler="Cell_MouseLeftButtonDown"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#555"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#777"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Статус" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="6,2" 
                                            Background="{Binding IsAvailable, Converter={StaticResource StatusToColorConverter}}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IsAvailable, Converter={StaticResource StatusToTextConverter}}"
                                                   Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Действие" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="📖 Взять/Вернуть" 
                                            Command="{Binding DataContext.ToggleAvailabilityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Background="#4CAF50" Foreground="White" BorderThickness="0"
                                            Height="30" Width="100" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="DescriptionPanel" Grid.Row="5" CornerRadius="8" Background="#FFF8E1" 
                        Padding="15" Margin="0,5,0,0" BorderBrush="#FFE082" BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="DescriptionTitle" FontWeight="Bold" FontSize="14" Foreground="#E65100"/>
                            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#555"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✖ Закрыть" Width="70" Height="28" 
                                Click="CloseDescription_Click" Background="#FF9800" Foreground="White"
                                BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </DockPanel>
</Window>