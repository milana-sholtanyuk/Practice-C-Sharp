<Window x:Class="LibraryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Электронная библиотека" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddBookCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditBookCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DeleteBookCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Меню -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Книги">
                <MenuItem Header="Добавить" Command="{Binding AddBookCommand}"/>
                <MenuItem Header="Редактировать" Command="{Binding EditBookCommand}"/>
                <MenuItem Header="Удалить" Command="{Binding DeleteBookCommand}"/>
            </MenuItem>
            <MenuItem Header="_Поиск">
                <MenuItem Header="Найти" Click="Search_Click"/>
            </MenuItem>
            <MenuItem Header="_Настройки"/>
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <Button Content="➕ Добавить" Command="{Binding AddBookCommand}" Margin="2"/>
            <Button Content="✏ Редактировать" Command="{Binding EditBookCommand}" Margin="2"/>
            <Button Content="❌ Удалить" Command="{Binding DeleteBookCommand}" Margin="2"/>
        </ToolBar>

        <!-- Таблица книг -->
        <DataGrid ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}"
                  AutoGenerateColumns="False" IsReadOnly="True" Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="120"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="100"/>
                <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>