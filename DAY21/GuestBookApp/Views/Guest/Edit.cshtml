@model GuestBookApp.Models.FeedbackViewModel

@{
    ViewBag.Title = "Редактирование отзыва";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .container {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
    }

    .form-section {
        background: #f5f5f5;
        padding: 20px;
        border-radius: 8px;
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
        }

    .form-control {
        width: 100%;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 4px;
    }

    textarea.form-control {
        height: 150px;
    }

    .rating-group {
        display: flex;
        gap: 15px;
        align-items: center;
    }

        .rating-group label {
            display: inline-block;
            margin-bottom: 0;
            font-weight: normal;
        }

    .btn-save {
        background: #28a745;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

    .btn-cancel {
        background: #6c757d;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        margin-left: 10px;
    }

    .text-danger {
        color: #dc3545;
        font-size: 12px;
        margin-top: 5px;
        display: block;
    }
</style>

<div class="container">
    <div class="form-section">
        <h2>Редактирование отзыва</h2>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Имя пользователя</label>
                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Текст отзыва</label>
                @Html.TextAreaFor(m => m.Message, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Message, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Рейтинг (1-5)</label>
                <div class="rating-group">
                    <label>@Html.RadioButtonFor(m => m.Rating, 1) 1</label>
                    <label>@Html.RadioButtonFor(m => m.Rating, 2) 2</label>
                    <label>@Html.RadioButtonFor(m => m.Rating, 3) 3</label>
                    <label>@Html.RadioButtonFor(m => m.Rating, 4) 4</label>
                    <label>@Html.RadioButtonFor(m => m.Rating, 5) 5</label>
                </div>
                @Html.ValidationMessageFor(m => m.Rating, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn-save">Сохранить</button>
            <a href="@Url.Action("Index")" class="btn-cancel">Отмена</a>
        }
    </div>
</div>