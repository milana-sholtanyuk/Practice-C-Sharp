@model IEnumerable<GuestBookApp.Models.Feedback>

@{
    ViewBag.Title = "Управление отзывами";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 12px;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }

    th {
        background-color: #f2f2f2;
        font-weight: bold;
    }

    tr:hover {
        background-color: #f5f5f5;
    }

    .btn {
        padding: 5px 10px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        font-size: 12px;
    }

    .btn-edit {
        background: #ffc107;
        color: #333;
    }

    .btn-delete {
        background: #dc3545;
        color: white;
    }

    .btn-back {
        background: #007bff;
        color: white;
        padding: 10px 20px;
        margin-bottom: 20px;
        display: inline-block;
    }

    .alert-success {
        background: #d4edda;
        color: #155724;
        padding: 10px;
        border-radius: 4px;
        margin-bottom: 20px;
    }

    .rating-stars {
        color: #ffc107;
    }
</style>

<div class="container">
    <a href="@Url.Action("Recent")" class="btn-back">← Назад к отзывам</a>

    <h2>Управление отзывами</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Имя</th>
                <th>Отзыв</th>
                <th>Рейтинг</th>
                <th>Дата</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.UserName</td>
                    <td>@(item.Message.Length > 50 ? item.Message.Substring(0, 50) + "..." : item.Message)</td>
                    <td class="rating-stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= item.Rating)
                            {
                                <span>★</span>
                            }
                            else
                            {
                                <span>☆</span>
                            }
                        }
                    </td>
                    <td>@item.SubmittedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-edit">Редактировать</a>

                        @using (Html.BeginForm("Delete", "Guest", FormMethod.Post, new { style = "display: inline;" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-delete" onclick="return confirm('Удалить отзыв?')">Удалить</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <p>Нет отзывов для отображения.</p>
    }
</div>