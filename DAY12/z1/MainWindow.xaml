<Window x:Class="z1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:z1.ViewModels"
        Title="Электронная библиотека" Height="550" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📚 Электронная библиотека" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="🔍 Поиск: " VerticalAlignment="Center" FontSize="14" Margin="5"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300" Height="25" VerticalContentAlignment="Center"/>
            <TextBlock Text=" (название, автор, жанр)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" FontStyle="Italic"/>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredBooks}" SelectedItem="{Binding SelectedBook}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  Margin="0,5,0,5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="120"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="100"/>
                <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3">
            <Button Content="📖 Открыть книгу" Width="150" Height="30" HorizontalAlignment="Left"
                    Click="OpenBookButton_Click" Margin="0,5"/>

            <Expander Header="📄 Подробное описание" IsExpanded="False" Margin="0,5">
                <TextBlock Text="{Binding SelectedBook.Description}" TextWrapping="Wrap" 
                           Padding="10" FontSize="13" Background="#F0F0F0"/>
            </Expander>
        </StackPanel>
    </Grid>
</Window>